# Runtime outputs — never commit machine results / artifacts
/results/*
!/results/.gitkeep

# Build artifacts
/build/

# LLM models (too large for git)
/models/

# Third-party source (llama.cpp etc, built by deploy.sh --with-llm)
/third_party/

# Old web dashboard (replaced by gui/)
/web/

# Packaged run bundle (self-extracting archive, too large for git)
*.run

# Firmware blobs
/firmware/

# Nested project copy (now a separate repo: r9700-usb-diag)
/r9700-suite/

# Editor / OS noise
*.swp
.DS_Store
__pycache__/
*.pyc
